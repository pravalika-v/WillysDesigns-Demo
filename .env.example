PORT=3000
DB_PROVIDER=sqlite
DB_PATH=./data/enquiries.sqlite
# Set DB_PROVIDER=turso to use the remote database (no local fallback).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Exact public HTTPS origin, without trailing slash:
# PUBLIC_ORIGIN=https://your-demo.example
# Leave at 0 unless you have verified the trusted reverse-proxy chain.
TRUST_PROXY_HOPS=0
